# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_string_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── Admin default credentials (used by seed.js) ─────────────────────────────
ADMIN_EMAIL=admin@tempmailpro.local
ADMIN_PASSWORD=Admin@1234!

# ─── Email expiry ─────────────────────────────────────────────────────────────
# Minutes before a temp email address expires (default 60)
EMAIL_TTL_MINUTES=60

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── SMTP (optional – for forwarding feature) ─────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=smtp_password_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:8080
